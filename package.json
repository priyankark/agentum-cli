{
  "name": "agentum",
  "version": "1.0.0",
  "description": "Mirror terminal sessions and AI coding agents to mobile over WebSocket",
  "main": "dist/index.js",
  "bin": {
    "ag": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "test": "./tests/run-all-tests.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "terminal",
    "websocket",
    "mobile",
    "pty",
    "claude",
    "copilot",
    "codex",
    "ai",
    "agent",
    "remote",
    "vnc"
  ],
  "author": "Priyankar Kumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyankark/agentum-cli.git"
  },
  "bugs": {
    "url": "https://github.com/priyankark/agentum-cli/issues"
  },
  "homepage": "https://github.com/priyankark/agentum-cli#readme",
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "jimp": "^1.6.0",
    "node-pty": "^1.0.0",
    "screenshot-desktop": "^1.15.2",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
