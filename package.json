{
  "name": "agentum",
  "version": "2.0.1",
  "description": "Mirror terminal sessions and AI coding agents to mobile over WebSocket",
  "main": "dist/index.js",
  "bin": {
    "ag": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "test:security": "npm test",
    "test:legacy": "./tests/run-all-tests.sh",
    "test:platform": "npm run build && node --test tests/platform.test.cjs",
    "test:package": "node scripts/verify-package-install.cjs"
  },
  "keywords": [
    "vibe-coding",
    "mobile-coding",
    "code-from-phone",
    "codex-mirror",
    "claude-mirror",
    "copilot-mirror",
    "ai-agent-mobile",
    "remote-coding",
    "terminal-mirror",
    "afk-coding"
  ],
  "author": "AirCodum (https://aircodum.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priyankark/agentum-cli.git"
  },
  "bugs": {
    "url": "https://github.com/priyankark/agentum-cli/issues"
  },
  "homepage": "https://github.com/priyankark/agentum-cli#readme",
  "dependencies": {
    "@hurdlegroup/robotjs": "^0.12.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "jimp": "^1.6.0",
    "node-pty": "1.1.0",
    "qrcode": "^1.5.4",
    "screenshot-desktop": "^1.15.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/ws": "^8.5.10",
    "jsqr": "^1.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
